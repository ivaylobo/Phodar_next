  "mainInfo": {
    "additional": {
      "headline": "We invite you to the XIV International Photo Festival - PHODAR Biennial",
      "highlightText": "Events:",
      "mainSectionText": "<ul>\n<li><strong>Opening of the exposition</strong> including the selected works and announcement of the prize winners &#8211; 04.03.2025, 6 pm.</li>\n<li><strong>Theoretical seminar</strong> on &#8220;Photographic Reality&#8221; &#8211; 11.03.2025, 6 pm in the exhibition hall. The seminar will be attended by experts in the field of humanities and visual arts from St. Kliment Ohridski&#8221;, NATFA, NBU and other higher education institutions, representatives of galleries and NGOs active in visual arts, students, amateur photographers and established visual artists.</li>\n<li><strong>Tour of the exhibition</strong> &#8211; 16.03.2025, 1 pm for those who wish to find out more about the festival and the general exhibition.</li>\n</ul>\n",
      "shouldShow": false
    },
